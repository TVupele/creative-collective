generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
}

// Admin accounts only — there is no public signup. Admins upload and manage
// products on behalf of members, who are not system users themselves.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Int           // stored in kobo (smallest currency unit) to avoid float rounding
  images      String[]
  category    String
  stock       Int           @default(1)
  status      ProductStatus @default(DRAFT)

  // The member (artist/creative) this item belongs to. Members are not
  // system users — they submit items via email/WhatsApp, and an admin
  // uploads on their behalf. These fields exist purely for payout tracking.
  memberName         String
  memberContact      String   // phone or email, however they were reached
  memberBankName     String?
  memberAccountNumber String?
  memberAccountName  String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems  OrderItem[]

  @@index([status, category])
}

model Order {
  id                String      @id @default(cuid())
  buyerName         String
  buyerEmail        String
  buyerPhone        String
  shippingAddress   String
  totalAmount       Int         // kobo — the full amount the buyer paid
  paystackReference String?     @unique
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
}

model OrderItem {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Int          // kobo, price at time of purchase

  // Carried over from the product at time of sale, so this record stays
  // accurate even if the product is edited or removed later.
  memberName        String
  memberContact     String
  commissionPercent Int          // e.g. 20 for 20%, locked in at time of sale
  payoutAmount      Int          // kobo, unitPrice * quantity minus commission
  payoutStatus      PayoutStatus @default(PENDING)
}
